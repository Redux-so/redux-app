# Redux environment configuration (placeholders only — never commit real secrets).
#
# Setup:
#   1. Copy this file to `.env` (Prisma CLI, scripts) and/or `.env.local` (Next.js).
#   2. Fill in values from team secrets or each service dashboard.
#   3. Keep `.env` / `.env.local` out of git (see `.gitignore`).
#
# Next.js loads `.env.local` over `.env`. Shared values (e.g. DATABASE_URL) can live in both.

# ------------------------------------------------------------------------------
# Database (PostgreSQL / Neon + pgvector)
# ------------------------------------------------------------------------------
# Pooled connection for the app (Prisma `url`).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
# Direct connection for migrations (Prisma `directUrl`).
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# ------------------------------------------------------------------------------
# Application URLs
# ------------------------------------------------------------------------------
# Optional Next.js mount point. Set to /app for the redux.so deployment.
NEXT_PUBLIC_APP_BASE_PATH=
# Public app URL, including the mount point if set (no trailing slash).
NEXT_PUBLIC_APP_URL=https://your-public-app-origin.example

# ------------------------------------------------------------------------------
# Clerk (authentication)
# ------------------------------------------------------------------------------
# From Clerk Dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret (Clerk Dashboard → Webhooks → endpoint for /api/webhooks/clerk).
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Closed beta grant. Set to 0 before opening Clerk signup.
CLOSED_BETA_STARTER_CREDITS=150

# ------------------------------------------------------------------------------
# Cloudinary (image storage & transforms)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# UploadThing (legacy asset cleanup only)
# ------------------------------------------------------------------------------
# Optional locally unless testing permanent delete of legacy `utKey` images.
UPLOADTHING_TOKEN=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Anthropic (chat / vision AI)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Replicate (heal, CLIP search, captions, etc.)
# ------------------------------------------------------------------------------
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Stripe (credits checkout & billing portal)
# ------------------------------------------------------------------------------
CREDIT_PURCHASES_ENABLED=false
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe Dashboard → Developers → Webhooks → signing secret for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Vercel KV (rate limiting)
# ------------------------------------------------------------------------------
# Required in production (`lib/kv.ts`). Optional locally — limits no-op without KV.
# From Vercel project → Storage → KV → Connect / env vars.
KV_REST_API_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Sentry (errors, traces, session replay)
# ------------------------------------------------------------------------------
# Browser SDK prefers NEXT_PUBLIC_*; server can use SENTRY_DSN or the public DSN.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional: source map upload during `pnpm run build` / CI (GitHub Actions secret).
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional webpack plugin targets (defaults: org redux-xn, project javascript-nextjs).
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# Sample rates 0–1 (omit for code defaults: traces 0.1 prod / 1 dev).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Client replay sampling (NEXT_PUBLIC_* preferred; SENTRY_* fallbacks read in instrumentation-client.ts).
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.25
# SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.25
# Send console logs to Sentry: true | false (default off in production).
SENTRY_ENABLE_LOGS=false

# ------------------------------------------------------------------------------
# Vercel platform (usually automatic on deploy)
# ------------------------------------------------------------------------------
# Set by Vercel: production | preview | development. Used for rate-limit enforcement.
# VERCEL_ENV=development

# ------------------------------------------------------------------------------
# Optional: maintenance scripts (pnpm run embed:all, dev diagnostics)
# ------------------------------------------------------------------------------
# Milliseconds between Replicate calls in scripts/reembed-images.ts (default 11000).
# REEMBED_BETWEEN_REPLICATE_MS=11000
# Re-embed all images, not only missing embeddings: 1 | true
# REEMBED_ALL=false
# Comma-separated routes for scripts/measure-dev-memory.mjs (default /)
# DEV_MEMORY_ROUTES=/

# ------------------------------------------------------------------------------
# CI / build tooling (normally set by GitHub Actions or local CI, not required for dev)
# ------------------------------------------------------------------------------
# CI=true
