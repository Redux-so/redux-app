generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model User {
  id              String             @id @default(cuid())
  clerkId         String             @unique
  email           String             @unique
  name            String?
  creditBalance   Int                @default(0)
  lifetimeFreeAI  Int                @default(0)
  images          Image[]
  albums          Album[]
  transactions    CreditTransaction[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Image {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  filename    String
  originalUrl String
  previewUrl  String?
  publicId    String
  width       Int
  height      Int
  size        Int
  format      String
  utKey       String?
  /// pgvector column (768 = CLIP ViT-L/14). Managed via $executeRaw / $queryRaw.
  embedding   Unsupported("vector(768)")?
  metadata    Json?
  deletedAt   DateTime?
  versions    ImageVersion[]
  albumMembers AlbumImage[]
  chatTurns   ChatTurn[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, deletedAt])
}

/// One durable user/assistant exchange. Sequence keeps pagination stable across tabs.
model ChatTurn {
  id                 String   @id @default(uuid())
  sequence           Int      @unique @default(autoincrement())
  imageId            String
  image              Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  userText           String
  assistantText      String   @default("")
  attachmentUrl      String?
  attachmentPublicId String?
  mode               String   @default("agent")
  status             String   @default("streaming")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([imageId, sequence])
}

model Album {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  members   AlbumImage[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

model AlbumImage {
  albumId   String
  imageId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([albumId, imageId])
  @@index([imageId])
}

model ImageVersion {
  id          String   @id @default(cuid())
  imageId     String
  image       Image    @relation(fields: [imageId], references: [id])
  url         String
  publicId    String
  adjustments Json
  label       String?
  createdAt   DateTime @default(now())
}

model CreditTransaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  type        TransactionType
  amount      Int             // positive = added, negative = deducted
  feature     String?         // e.g. "auto_enhance", "remove_background"
  bundleId    String?         // which bundle was purchased
  stripeId    String?         // Stripe payment intent or session ID
  description String?
  createdAt   DateTime        @default(now())
}

model CreditBundle {
  id          String   @id @default(cuid())
  name        String   // "Starter", "Basic", "Pro", etc.
  credits     Int      // how many credits it gives
  price       Int      // in cents, e.g. 500 = $5.00
  stripePriceId String // the price ID from Stripe
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

enum TransactionType {
  PURCHASE    // user bought credits
  DEDUCTION   // credits spent on AI feature
  REFUND      // credits returned on failure
  BONUS       // free credits granted
}
